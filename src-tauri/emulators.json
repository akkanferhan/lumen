  "emulators": [
    {
      "id": "retroarch", "name": "RetroArch",
      "source": { "type": "url", "url": "https://buildbot.libretro.com/nightly/windows/x86_64/RetroArch.7z" },
      "exe": ["**/retroarch.exe"], "args": ["-f", "-L", "{core}", "{rom}"]
    },
    {
      "id": "duckstation", "name": "DuckStation",
      "source": { "type": "github", "repo": "stenzek/duckstation", "tag": "latest", "asset": "duckstation-windows-x64-release\\.zip$" },
      "exe": ["**/duckstation-qt*.exe"], "args": ["-batch", "-fullscreen", "--", "{rom}"], "portableFiles": ["portable.txt"]
    },
    {
      "id": "pcsx2", "name": "PCSX2",
      "source": { "type": "github", "repo": "PCSX2/pcsx2", "asset": "windows-x64-Qt\\.7z$" },
      "exe": ["**/pcsx2-qt*.exe"], "args": ["-batch", "-nogui", "-fullscreen", "{rom}"], "portableFiles": ["portable.ini"]
    },
    {
      "id": "dolphin", "name": "Dolphin",
      "source": { "type": "page", "page": "https://dolphin-emu.org/update/latest/beta/", "pattern": "https://dl\\.dolphin-emu\\.org/releases/[^\"]+-x64\\.7z" },
      "exe": ["**/Dolphin.exe"], "args": ["-b", "-e", "{rom}"], "portableFiles": ["portable.txt"]
    },
    {
      "id": "ppsspp", "name": "PPSSPP",
      "source": { "type": "page", "page": "https://www.ppsspp.org/download/", "pattern": "/files/[0-9_]+/ppsspp_win\\.zip", "base": "https://www.ppsspp.org" },
      "exe": ["**/PPSSPPWindows64.exe"], "args": ["--fullscreen", "{rom}"]
    },
    {
      "id": "melonds", "name": "melonDS",
      "source": { "type": "github", "repo": "melonDS-emu/melonDS", "asset": "windows.*x86_64.*\\.zip$" },
      "exe": ["**/melonDS.exe"], "args": ["-f", "{rom}"]
    },
    {
