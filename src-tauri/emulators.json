      "exe": ["**/retroarch.exe"], "args": ["-f", "-L", "{core}", "{rom}"]
    },
    {
      "id": "duckstation", "name": "DuckStation",
      "source": { "type": "github", "repo": "stenzek/duckstation", "tag": "latest", "asset": "duckstation-windows-x64-release\\.zip$" },
