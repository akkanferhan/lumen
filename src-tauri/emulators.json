      "exe": ["**/Vita3K.exe"], "args": ["--frontend", "sdl", "-F", "-B", "Vulkan", "{rom}"]
    },
    {
      "id": "shadps4", "name": "shadPS4",
      "source": { "type": "github", "repo": "shadps4-emu/shadPS4", "asset": "win64-sdl.*\\.zip$" },
      "exe": ["**/shadPS4.exe"], "args": ["-f", "true", "-g", "{rom}"]
